generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/*
|--------------------------------------------------------------------------
| ENUMS
|--------------------------------------------------------------------------
*/

enum RecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RoleScope {
  SYSTEM
  ORGANIZATION
  BRANCH
}

enum MediaStatus {
  ACTIVE
  PENDING_DELETE
  DELETED
  FAILED
}

enum MediaResourceType {
  IMAGE
  VIDEO
  RAW
}

enum MediaDeliveryType {
  UPLOAD
  FETCH
  PRIVATE
  AUTHENTICATED
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

enum ProductType {
  FOOD
  BEVERAGE
  COMBO
  MERCHANDISE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum InventoryItemType {
  RAW_MATERIAL
  PACKAGING
  FINISHED_GOOD
  CONSUMABLE
  OTHER
}

enum InventoryTrackingMode {
  NONE
  BATCH
  SERIAL
  EXPIRY
}

enum StockMovementType {
  OPENING
  PURCHASE
  PURCHASE_RETURN
  SALE
  SALE_RETURN
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  WASTE
  DAMAGE
  PRODUCTION_IN
  PRODUCTION_OUT
  STOCK_COUNT
  REVERSAL
}

enum StockDirection {
  IN
  OUT
}

enum TransferStatus {
  DRAFT
  REQUESTED
  APPROVED
  REJECTED
  PACKED
  IN_TRANSIT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  REQUESTED
  APPROVED
  REJECTED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
  CLOSED
}

enum GoodsReceiptStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  PICKUP
  DELIVERY
  QR_ORDER
}

enum OrderChannel {
  POS
  WEBSITE
  MOBILE
  ADMIN
  QR
  PHONE
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
  REJECTED
}

enum FulfillmentStatus {
  UNFULFILLED
  PREPARING
  READY
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
  PARTIALLY_REFUNDED
  FAILED
  VOIDED
}

enum PaymentMethod {
  CASH
  CARD
  BKASH
  NAGAD
  ROCKET
  BANK_TRANSFER
  MOBILE_BANKING
  ONLINE_PAYMENT
  CREDIT
  OTHER
}

enum PaymentTransactionStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  CANCELLED
}

enum RiderStatus {
  AVAILABLE
  BUSY
  OFFLINE
  SUSPENDED
}

enum KitchenTicketStatus {
  QUEUED
  ACCEPTED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum KitchenItemStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  INACTIVE
  EXPIRED
}

enum CouponStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  EXHAUSTED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  ADJUST
  EXPIRE
  REFUND
}

enum POSDeviceStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum POSShiftStatus {
  OPEN
  CLOSED
  FORCE_CLOSED
}

enum CashTransactionType {
  CASH_IN
  CASH_OUT
  EXPENSE
  REFUND
  ADJUSTMENT
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
  COST_OF_GOODS_SOLD
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum AccountingPeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  VOID
  REVERSED
}

enum JournalSourceType {
  MANUAL
  SALE
  SALE_RETURN
  PURCHASE
  PURCHASE_RETURN
  EXPENSE
  PAYMENT
  REFUND
  STOCK_ADJUSTMENT
  STOCK_TRANSFER
  OPENING_BALANCE
  OTHER
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  VOID
}

enum LedgerEntryType {
  INVOICE
  PAYMENT
  REFUND
  CREDIT_NOTE
  DEBIT_NOTE
  OPENING_BALANCE
  ADJUSTMENT
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

enum TaxType {
  VAT
  TAX
  SERVICE_CHARGE
  OTHER
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
  OUT_OF_SERVICE
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum NotificationType {
  ORDER
  PAYMENT
  DELIVERY
  INVENTORY
  SYSTEM
  PROMOTION
  SECURITY
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  YOUTUBE
  TIKTOK
  LINKEDIN
  X
  WHATSAPP
  WEBSITE
  OTHER
}

/*
|--------------------------------------------------------------------------
| ORGANIZATION / TENANT
|--------------------------------------------------------------------------
*/

model Organization {
  id                String       @id @default(cuid())
  name              String
  slug              String       @unique
  legalName         String?
  description       String?      @db.Text
  email             String?
  phone             String?
  website           String?
  currency          String       @default("BDT")
  timezone          String       @default("Asia/Dhaka")
  locale            String       @default("en-BD")
  taxNumber         String?
  vatNumber         String?
  status            RecordStatus @default(ACTIVE)

  logoAssetId       String?      @unique
  logoAsset         CloudinaryAsset? @relation(
    "OrganizationLogo",
    fields: [logoAssetId],
    references: [id],
    onDelete: SetNull
  )

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  users             User[]
  branches          Branch[]
  roles             Role[]
  settings          Setting?
  contactInfo       ContactInfo?
  faqs              FAQ[]
  socialLinks       SocialLink[]
  banners           SiteBanner[]

  categories        Category[]
  products          Product[]
  modifierGroups    ModifierGroup[]

  inventoryItems    InventoryItem[]
  suppliers         Supplier[]
  customers         Customer[]

  orders            Order[]
  carts             Cart[]

  deliveryZones     DeliveryZone[]
  tables            DiningTable[]
  reservations      Reservation[]

  kitchenStations   KitchenStation[]

  purchaseOrders    PurchaseOrder[]
  goodsReceipts     GoodsReceipt[]
  stockTransfers    StockTransfer[]

  taxRates          TaxRate[]

  discounts         Discount[]
  promotions        Promotion[]
  coupons           Coupon[]

  loyaltyPrograms   LoyaltyProgram[]

  chartOfAccounts   ChartOfAccount[]
  accountingPeriods AccountingPeriod[]
  journalEntries    JournalEntry[]

  salesInvoices     SalesInvoice[]
  customerLedgers   CustomerLedgerEntry[]

  supplierBills     SupplierBill[]
  supplierLedgers   SupplierLedgerEntry[]

  expenseCategories ExpenseCategory[]
  expenses          Expense[]

  posDevices        POSDevice[]
  posShifts         POSShift[]

  notifications     Notification[]
  auditLogs         AuditLog[]

  createdAtIndex    DateTime? // intentionally nullable for migration-safe indexing

  @@index([status])
  @@index([createdAt])
}

/*
|--------------------------------------------------------------------------
| BRANCH
|--------------------------------------------------------------------------
*/

model Branch {
  id              String       @id @default(cuid())
  organizationId  String
  code            String
  name            String
  slug            String
  description     String?      @db.Text

  address         String?
  area            String?
  city            String?
  postalCode      String?
  country         String       @default("Bangladesh")

  latitude        Decimal?     @db.Decimal(10, 7)
  longitude       Decimal?     @db.Decimal(10, 7)

  phone           String?
  email           String?

  openingTime     String?
  closingTime     String?

  status          BranchStatus @default(ACTIVE)

  imageAssetId    String?
  imageAsset      CloudinaryAsset? @relation(
    "BranchImage",
    fields: [imageAssetId],
    references: [id],
    onDelete: SetNull
  )

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization    Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  userBranches    UserBranch[]
  productBranches ProductBranch[]

  inventoryBalances InventoryBalance[]
  inventoryBatches  InventoryBatch[]
  stockMovements    StockMovement[]

  transfersFrom   StockTransfer[] @relation("TransferFromBranch")
  transfersTo     StockTransfer[] @relation("TransferToBranch")

  orders          Order[]

  deliveryZones   DeliveryZone[]
  tables          DiningTable[]
  reservations    Reservation[]

  kitchenStations KitchenStation[]

  purchaseOrders  PurchaseOrder[]
  goodsReceipts   GoodsReceipt[]

  journalEntries  JournalEntry[]
  expenses        Expense[]

  posDevices      POSDevice[]
  posShifts       POSShift[]

  auditLogs       AuditLog[]

  carts           Cart[]

  @@unique([organizationId, code])
  @@unique([organizationId, slug])
  @@index([organizationId, status])
}

/*
|--------------------------------------------------------------------------
| USERS / RBAC
|--------------------------------------------------------------------------
*/

model User {
  id              String     @id @default(cuid())
  organizationId  String

  firstName       String
  lastName        String?
  email           String
  phone           String?
  passwordHash    String

  status          UserStatus @default(ACTIVE)

  avatarAssetId   String?
  avatarAsset     CloudinaryAsset? @relation(
    "UserAvatar",
    fields: [avatarAssetId],
    references: [id],
    onDelete: SetNull
  )

  lastLoginAt     DateTime?
  emailVerifiedAt DateTime?

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  organization    Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  roles           UserRole[]
  branches        UserBranch[]

  createdOrders   Order[] @relation("OrderCreatedBy")
  changedStatuses OrderStatusHistory[] @relation("OrderStatusChangedBy")

  requestedTransfers StockTransfer[] @relation("TransferRequestedBy")
  approvedTransfers  StockTransfer[] @relation("TransferApprovedBy")
  shippedTransfers   StockTransfer[] @relation("TransferShippedBy")
  receivedTransfers  StockTransfer[] @relation("TransferReceivedBy")

  createdPurchaseOrders  PurchaseOrder[] @relation("PurchaseOrderCreatedBy")
  approvedPurchaseOrders PurchaseOrder[] @relation("PurchaseOrderApprovedBy")

  receivedGoodsReceipts GoodsReceipt[] @relation("GoodsReceiptReceivedBy")

  openedShifts POSShift[] @relation("ShiftOpenedBy")
  closedShifts POSShift[] @relation("ShiftClosedBy")

  createdJournalEntries JournalEntry[] @relation("JournalCreatedBy")

  createdExpenses  Expense[] @relation("ExpenseCreatedBy")
  approvedExpenses Expense[] @relation("ExpenseApprovedBy")

  riderProfile RiderProfile?

  notifications Notification[]

  auditLogs AuditLog[]

  @@unique([organizationId, email])
  @@index([organizationId, status])
}

model Role {
  id             String    @id @default(cuid())
  organizationId String?
  name           String
  description    String?
  scope          RoleScope @default(ORGANIZATION)
  isSystemRole   Boolean   @default(false)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization? @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  users           UserRole[]
  permissions     RolePermission[]

  @@unique([organizationId, name])
  @@index([scope])
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  module      String?

  createdAt   DateTime @default(now())

  roles       RolePermission[]
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String

  createdAt DateTime @default(now())

  user      User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  role      Role @relation(
    fields: [roleId],
    references: [id],
    onDelete: Cascade
  )

  @@unique([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role         Role @relation(
    fields: [roleId],
    references: [id],
    onDelete: Cascade
  )

  permission   Permission @relation(
    fields: [permissionId],
    references: [id],
    onDelete: Cascade
  )

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model UserBranch {
  id        String   @id @default(cuid())
  userId    String
  branchId  String
  isPrimary Boolean  @default(false)

  createdAt DateTime @default(now())

  user      User   @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  branch    Branch @relation(
    fields: [branchId],
    references: [id],
    onDelete: Cascade
  )

  @@unique([userId, branchId])
  @@index([branchId])
}

/*
|--------------------------------------------------------------------------
| CLOUDINARY / MEDIA
|--------------------------------------------------------------------------
*/

model CloudinaryAsset {
  id                String              @id @default(cuid())

  publicId          String              @unique
  secureUrl         String              @db.Text
  url               String?             @db.Text

  resourceType      MediaResourceType   @default(IMAGE)
  deliveryType      MediaDeliveryType   @default(UPLOAD)

  format            String?
  folder            String?
  version           Int?

  originalFilename  String?
  bytes             BigInt?
  width             Int?
  height            Int?
  duration          Decimal?            @db.Decimal(12, 3)

  etag              String?
  tags              Json?
  context           Json?
  metadata          Json?

  status            MediaStatus         @default(ACTIVE)

  deleteAttempts    Int                 @default(0)
  lastDeleteError   String?             @db.Text
  deletedAt         DateTime?

  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  organizationLogos Organization[] @relation("OrganizationLogo")
  settingLogos      Setting[]      @relation("SettingLogo")
  settingFavicons   Setting[]      @relation("SettingFavicon")

  branchImages      Branch[]       @relation("BranchImage")
  userAvatars       User[]         @relation("UserAvatar")

  categoryImages    Category[]     @relation("CategoryImage")
  productImages     ProductImage[]

  siteBannerImages  SiteBanner[]   @relation("SiteBannerImage")

  @@index([status])
  @@index([resourceType])
  @@index([createdAt])
}

/*
|--------------------------------------------------------------------------
| WEBSITE / CMS SETTINGS
|--------------------------------------------------------------------------
*/

model Setting {
  id                String   @id @default(cuid())
  organizationId    String   @unique

  siteName          String?
  tagline           String?
  description       String?  @db.Text

  logoAssetId       String?
  faviconAssetId    String?

  logoAsset         CloudinaryAsset? @relation(
    "SettingLogo",
    fields: [logoAssetId],
    references: [id],
    onDelete: SetNull
  )

  faviconAsset      CloudinaryAsset? @relation(
    "SettingFavicon",
    fields: [faviconAssetId],
    references: [id],
    onDelete: SetNull
  )

  primaryColor      String?
  secondaryColor    String?
  accentColor       String?

  defaultCurrency   String   @default("BDT")
  timezone          String   @default("Asia/Dhaka")
  locale            String   @default("en-BD")

  orderSettings     Json?
  deliverySettings  Json?
  paymentSettings   Json?
  invoiceSettings   Json?
  seoSettings       Json?
  socialSettings    Json?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization      Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )
}

model ContactInfo {
  id             String   @id @default(cuid())
  organizationId String   @unique

  email          String?
  phone          String?
  alternatePhone String?
  whatsapp       String?

  address        String?  @db.Text
  mapUrl         String?  @db.Text

  openingHours   Json?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )
}

model FAQ {
  id             String   @id @default(cuid())
  organizationId String

  question       String   @db.Text
  answer         String   @db.Text

  sortOrder      Int      @default(0)
  isPublished    Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  @@index([organizationId, isPublished, sortOrder])
}

model SocialLink {
  id             String         @id @default(cuid())
  organizationId String

  platform       SocialPlatform
  label          String?
  url            String         @db.Text
  icon           String?

  sortOrder      Int            @default(0)
  isActive       Boolean        @default(true)

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization   Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  @@index([organizationId, platform])
}

model SiteBanner {
  id             String   @id @default(cuid())
  organizationId String

  title          String?
  subtitle       String?  @db.Text
  buttonText     String?
  buttonUrl      String?

  imageAssetId   String?
  imageAsset     CloudinaryAsset? @relation(
    "SiteBannerImage",
    fields: [imageAssetId],
    references: [id],
    onDelete: SetNull
  )

  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)

  startsAt       DateTime?
  endsAt         DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  @@index([organizationId, isActive, sortOrder])
}

/*
|--------------------------------------------------------------------------
| CATALOG
|--------------------------------------------------------------------------
*/

model Category {
  id             String       @id @default(cuid())
  organizationId String

  parentId       String?
  name           String
  slug           String
  description    String?      @db.Text

  imageAssetId   String?
  imageAsset     CloudinaryAsset? @relation(
    "CategoryImage",
    fields: [imageAssetId],
    references: [id],
    onDelete: SetNull
  )

  status         RecordStatus @default(ACTIVE)
  sortOrder      Int          @default(0)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  parent         Category? @relation(
    "CategoryTree",
    fields: [parentId],
    references: [id],
    onDelete: SetNull
  )

  children       Category[] @relation("CategoryTree")

  products       Product[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@index([parentId])
}

model Product {
  id             String        @id @default(cuid())
  organizationId String
  categoryId     String

  name           String
  slug           String
  sku            String
  barcode        String?

  description    String?       @db.Text

  productType    ProductType   @default(FOOD)
  status         ProductStatus @default(DRAFT)

  basePrice      Decimal       @db.Decimal(18, 2)
  costPrice      Decimal?      @db.Decimal(18, 2)

  taxRateId      String?

  isFeatured     Boolean       @default(false)
  isAvailable    Boolean       @default(true)
  trackInventory Boolean       @default(true)

  prepTimeMin    Int?

  sortOrder      Int           @default(0)

  // Engagement counters (denormalized for performance)
  viewCount      Int           @default(0)
  likeCount      Int           @default(0)
  commentCount   Int           @default(0)
  shareCount     Int           @default(0)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  category       Category @relation(
    fields: [categoryId],
    references: [id],
    onDelete: Restrict
  )

  taxRate        TaxRate? @relation(
    fields: [taxRateId],
    references: [id],
    onDelete: SetNull
  )

  images         ProductImage[]
  variants       ProductVariant[]
  branchSettings ProductBranch[]

  modifierGroups ProductModifierGroup[]

  recipes        Recipe[]

  orderItems     OrderItem[]
  reviews        ProductReview[]

  cartItems      CartItem[]

  likes          ProductLike[]
  comments       ProductComment[]
  shares         ProductShare[]

  @@unique([organizationId, slug])
  @@unique([organizationId, sku])
  @@index([organizationId, status])
  @@index([categoryId])
  @@index([taxRateId])
}

model ProductImage {
  id          String   @id @default(cuid())
  productId   String
  assetId     String

  sortOrder   Int      @default(0)
  isPrimary   Boolean  @default(false)
  altText     String?

  createdAt   DateTime @default(now())

  product     Product @relation(
    fields: [productId],
    references: [id],
    onDelete: Cascade
  )

  asset       CloudinaryAsset @relation(
    fields: [assetId],
    references: [id],
    onDelete: Restrict
  )

  @@unique([productId, assetId])
  @@index([productId, sortOrder])
  @@index([assetId])
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String

  name           String
  sku            String
  barcode        String?

  price          Decimal  @db.Decimal(18, 2)
  costPrice      Decimal? @db.Decimal(18, 2)

  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product        Product @relation(
    fields: [productId],
    references: [id],
    onDelete: Cascade
  )

  recipes        Recipe[]
  orderItems     OrderItem[]
  cartItems      CartItem[]

  @@unique([productId, sku])
  @@index([productId, isActive])
}

model ProductBranch {
  id             String   @id @default(cuid())
  productId      String
  branchId       String

  price          Decimal? @db.Decimal(18, 2)
  costPrice      Decimal? @db.Decimal(18, 2)

  isAvailable    Boolean  @default(true)
  isFeatured     Boolean  @default(false)

  inventoryMode  InventoryTrackingMode @default(NONE)

  prepTimeMin    Int?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product        Product @relation(
    fields: [productId],
    references: [id],
    onDelete: Cascade
  )

  branch         Branch @relation(
    fields: [branchId],
    references: [id],
    onDelete: Cascade
  )

  @@unique([productId, branchId])
  @@index([branchId, isAvailable])
}

model ModifierGroup {
  id             String   @id @default(cuid())
  organizationId String

  name           String
  description    String?

  minSelection   Int      @default(0)
  maxSelection   Int      @default(1)

  isRequired     Boolean  @default(false)
  isActive       Boolean  @default(true)

  sortOrder      Int      @default(0)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  modifiers      Modifier[]
  products       ProductModifierGroup[]

  @@index([organizationId, isActive])
}

model Modifier {
  id             String   @id @default(cuid())
  modifierGroupId String

  name           String
  price          Decimal  @default(0) @db.Decimal(18, 2)

  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  modifierGroup  ModifierGroup @relation(
    fields: [modifierGroupId],
    references: [id],
    onDelete: Cascade
  )

  orderItems      OrderItemModifier[]

  @@index([modifierGroupId, isActive])
}

model ProductModifierGroup {
  id             String   @id @default(cuid())
  productId      String
  modifierGroupId String

  sortOrder      Int      @default(0)

  product        Product @relation(
    fields: [productId],
    references: [id],
    onDelete: Cascade
  )

  modifierGroup  ModifierGroup @relation(
    fields: [modifierGroupId],
    references: [id],
    onDelete: Cascade
  )

  @@unique([productId, modifierGroupId])
}

/*
|--------------------------------------------------------------------------
| PRODUCT ENGAGEMENT (Like / Comment / Share)
|--------------------------------------------------------------------------
*/

model ProductLike {
  id          String   @id @default(cuid())
  productId   String
  customerId  String

  createdAt   DateTime @default(now())

  product     Product  @relation(
    fields: [productId],
    references: [id],
    onDelete: Cascade
  )

  customer    Customer @relation(
    fields: [customerId],
    references: [id],
    onDelete: Cascade
  )

  @@unique([productId, customerId])
  @@index([productId])
  @@index([customerId])
}

model ProductComment {
  id          String       @id @default(cuid())
  productId   String
  customerId  String
  parentId    String?      // nested reply support

  content     String       @db.Text
  status      ReviewStatus @default(PENDING)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  product     Product  @relation(
    fields: [productId],
    references: [id],
    onDelete: Cascade
  )

  customer    Customer @relation(
    fields: [customerId],
    references: [id],
    onDelete: Cascade
  )

  parent      ProductComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     ProductComment[] @relation("CommentReplies")

  @@index([productId, createdAt])
  @@index([customerId])
  @@index([parentId])
}

model ProductShare {
  id          String          @id @default(cuid())
  productId   String
  customerId  String?         // guest share allowed

  platform    SocialPlatform?
  sharedAt    DateTime        @default(now())

  product     Product  @relation(
    fields: [productId],
    references: [id],
    onDelete: Cascade
  )

  customer    Customer? @relation(
    fields: [customerId],
    references: [id],
    onDelete: SetNull
  )

  @@index([productId])
  @@index([customerId])
  @@index([sharedAt])
}

/*
|--------------------------------------------------------------------------
| UNITS / INVENTORY
|--------------------------------------------------------------------------
*/

model Unit {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  symbol          String?
  decimalPlaces   Int      @default(2)

  createdAt       DateTime @default(now())

  inventoryItems  InventoryItem[]
  recipeItems     RecipeIngredient[]
  purchaseItems   PurchaseOrderItem[]
  receiptItems    GoodsReceiptItem[]

  fromConversions UnitConversion[] @relation("FromUnit")
  toConversions   UnitConversion[] @relation("ToUnit")
}

model UnitConversion {
  id             String   @id @default(cuid())

  fromUnitId     String
  toUnitId       String
  multiplier     Decimal  @db.Decimal(18, 6)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  fromUnit       Unit @relation(
    "FromUnit",
    fields: [fromUnitId],
    references: [id],
    onDelete: Cascade
  )

  toUnit         Unit @relation(
    "ToUnit",
    fields: [toUnitId],
    references: [id],
    onDelete: Cascade
  )

  @@unique([fromUnitId, toUnitId])
}

model InventoryItem {
  id                String                 @id @default(cuid())
  organizationId    String

  name              String
  sku               String
  barcode           String?

  type              InventoryItemType
  trackingMode      InventoryTrackingMode @default(NONE)

  unitId            String

  reorderLevel      Decimal                @default(0) @db.Decimal(18, 3)
  reorderQuantity   Decimal                @default(0) @db.Decimal(18, 3)

  standardCost      Decimal?               @db.Decimal(18, 4)

  isActive          Boolean                @default(true)

  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  organization      Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  unit              Unit @relation(
    fields: [unitId],
    references: [id],
    onDelete: Restrict
  )

  balances          InventoryBalance[]
  batches           InventoryBatch[]
  stockMovements    StockMovement[]

  transferItems     StockTransferItem[]

  purchaseItems     PurchaseOrderItem[]
  receiptItems      GoodsReceiptItem[]

  recipeIngredients RecipeIngredient[]

  @@unique([organizationId, sku])
  @@index([organizationId, type, isActive])
  @@index([unitId])
}

model InventoryBalance {
  id              String   @id @default(cuid())
  branchId        String
  inventoryItemId String

  quantity        Decimal  @default(0) @db.Decimal(18, 3)
  reservedQuantity Decimal @default(0) @db.Decimal(18, 3)

  averageCost     Decimal  @default(0) @db.Decimal(18, 4)

  updatedAt       DateTime @updatedAt

  branch          Branch @relation(
    fields: [branchId],
    references: [id],
    onDelete: Cascade
  )

  inventoryItem   InventoryItem @relation(
    fields: [inventoryItemId],
    references: [id],
    onDelete: Cascade
  )

  @@unique([branchId, inventoryItemId])
  @@index([inventoryItemId])
}

model InventoryBatch {
  id              String   @id @default(cuid())
  branchId        String
  inventoryItemId String

  batchNumber     String?
  quantity        Decimal  @db.Decimal(18, 3)
  unitCost        Decimal  @db.Decimal(18, 4)

  manufacturingDate DateTime?
  expiryDate        DateTime?

  receivedAt      DateTime @default(now())

  branch          Branch @relation(
    fields: [branchId],
    references: [id],
    onDelete: Cascade
  )

  inventoryItem   InventoryItem @relation(
    fields: [inventoryItemId],
    references: [id],
    onDelete: Cascade
  )

  stockMovements  StockMovement[]

  @@index([branchId, inventoryItemId])
  @@index([expiryDate])
  @@index([batchNumber])
}

model StockMovement {
  id              String             @id @default(cuid())
  branchId        String
  inventoryItemId String
  batchId         String?

  type            StockMovementType
  direction       StockDirection

  quantity        Decimal            @db.Decimal(18, 3)
  unitCost        Decimal?           @db.Decimal(18, 4)
  totalCost       Decimal?           @db.Decimal(18, 4)

  referenceType   String?
  referenceId     String?

  note            String?            @db.Text

  createdAt       DateTime           @default(now())

  branch          Branch @relation(
    fields: [branchId],
    references: [id],
    onDelete: Cascade
  )

  inventoryItem   InventoryItem @relation(
    fields: [inventoryItemId],
    references: [id],
    onDelete: Cascade
  )

  batch           InventoryBatch? @relation(
    fields: [batchId],
    references: [id],
    onDelete: SetNull
  )

  @@index([branchId, inventoryItemId, createdAt])
  @@index([referenceType, referenceId])
  @@index([batchId])
}

/*
|--------------------------------------------------------------------------
| RECIPES
|--------------------------------------------------------------------------
*/

model Recipe {
  id             String   @id @default(cuid())
  productId      String
  variantId      String?

  name           String?
  yieldQuantity  Decimal? @db.Decimal(18, 3)

  isActive       Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product        Product @relation(
    fields: [productId],
    references: [id],
    onDelete: Cascade
  )

  variant        ProductVariant? @relation(
    fields: [variantId],
    references: [id],
    onDelete: Cascade
  )

  ingredients    RecipeIngredient[]

  @@index([productId, isActive])
  @@index([variantId])
}

model RecipeIngredient {
  id              String   @id @default(cuid())
  recipeId        String
  inventoryItemId String
  unitId          String

  quantity        Decimal  @db.Decimal(18, 6)
  wastagePercent  Decimal  @default(0) @db.Decimal(8, 4)

  recipe          Recipe @relation(
    fields: [recipeId],
    references: [id],
    onDelete: Cascade
  )

  inventoryItem   InventoryItem @relation(
    fields: [inventoryItemId],
    references: [id],
    onDelete: Restrict
  )

  unit            Unit @relation(
    fields: [unitId],
    references: [id],
    onDelete: Restrict
  )

  @@index([recipeId])
  @@index([inventoryItemId])
}

/*
|--------------------------------------------------------------------------
| SUPPLIER / PURCHASE
|--------------------------------------------------------------------------
*/

model Supplier {
  id             String       @id @default(cuid())
  organizationId String

  supplierCode   String
  name           String
  contactPerson  String?

  phone          String?
  email          String?

  address        String?      @db.Text

  taxNumber      String?
  vatNumber      String?

  openingBalance Decimal      @default(0) @db.Decimal(18, 2)
  creditLimit    Decimal?     @db.Decimal(18, 2)
  paymentTerms   String?

  status         RecordStatus @default(ACTIVE)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]

  bills          SupplierBill[]
  ledgerEntries  SupplierLedgerEntry[]

  @@unique([organizationId, supplierCode])
  @@index([organizationId, status])
}

model PurchaseOrder {
  id             String              @id @default(cuid())
  organizationId String
  branchId       String
  supplierId     String

  purchaseOrderNo String

  status         PurchaseOrderStatus @default(DRAFT)

  orderDate      DateTime             @default(now())
  expectedDate   DateTime?

  subtotal       Decimal              @default(0) @db.Decimal(18, 2)
  discount       Decimal              @default(0) @db.Decimal(18, 2)
  tax            Decimal              @default(0) @db.Decimal(18, 2)
  total          Decimal              @default(0) @db.Decimal(18, 2)

  notes          String?              @db.Text

  createdById    String
  approvedById   String?

  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization   Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  branch         Branch @relation(
    fields: [branchId],
    references: [id],
    onDelete: Restrict
  )

  supplier       Supplier @relation(
    fields: [supplierId],
    references: [id],
    onDelete: Restrict
  )

  createdBy      User @relation(
    "PurchaseOrderCreatedBy",
    fields: [createdById],
    references: [id],
    onDelete: Restrict
  )

  approvedBy     User? @relation(
    "PurchaseOrderApprovedBy",
    fields: [approvedById],
    references: [id],
    onDelete: SetNull
  )

  items          PurchaseOrderItem[]
  goodsReceipts  GoodsReceipt[]

  @@unique([organizationId, purchaseOrderNo])
  @@index([branchId, status])
  @@index([supplierId, orderDate])
}

model PurchaseOrderItem {
  id              String   @id @default(cuid())
  purchaseOrderId String
  inventoryItemId String
  unitId          String

  quantity        Decimal  @db.Decimal(18, 3)
  receivedQuantity Decimal @default(0) @db.Decimal(18, 3)

  unitPrice       Decimal  @db.Decimal(18, 4)
  discount        Decimal  @default(0) @db.Decimal(18, 2)
  tax             Decimal  @default(0) @db.Decimal(18, 2)
  total           Decimal  @db.Decimal(18, 2)

  purchaseOrder   PurchaseOrder @relation(
    fields: [purchaseOrderId],
    references: [id],
    onDelete: Cascade
  )

  inventoryItem   InventoryItem @relation(
    fields: [inventoryItemId],
    references: [id],
    onDelete: Restrict
  )

  unit            Unit @relation(
    fields: [unitId],
    references: [id],
    onDelete: Restrict
  )

  @@index([purchaseOrderId])
  @@index([inventoryItemId])
}

model GoodsReceipt {
  id             String              @id @default(cuid())
  organizationId String
  branchId       String
  supplierId     String
  purchaseOrderId String?

  receiptNo      String
  status         GoodsReceiptStatus  @default(DRAFT)

  receivedAt     DateTime            @default(now())

  notes          String?             @db.Text

  receivedById   String

  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization   Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  branch         Branch @relation(
    fields: [branchId],
    references: [id],
    onDelete: Restrict
  )

  supplier       Supplier @relation(
    fields: [supplierId],
    references: [id],
    onDelete: Restrict
  )

  purchaseOrder  PurchaseOrder? @relation(
    fields: [purchaseOrderId],
    references: [id],
    onDelete: SetNull
  )

  receivedBy     User @relation(
    "GoodsReceiptReceivedBy",
    fields: [receivedById],
    references: [id],
    onDelete: Restrict
  )

  items          GoodsReceiptItem[]

  @@unique([organizationId, receiptNo])
  @@index([branchId, receivedAt])
  @@index([supplierId])
}

model GoodsReceiptItem {
  id              String   @id @default(cuid())
  goodsReceiptId  String
  inventoryItemId String
  unitId          String

  quantity        Decimal  @db.Decimal(18, 3)
  unitCost        Decimal  @db.Decimal(18, 4)

  batchNumber     String?
  expiryDate      DateTime?

  goodsReceipt    GoodsReceipt @relation(
    fields: [goodsReceiptId],
    references: [id],
    onDelete: Cascade
  )

  inventoryItem   InventoryItem @relation(
    fields: [inventoryItemId],
    references: [id],
    onDelete: Restrict
  )

  unit            Unit @relation(
    fields: [unitId],
    references: [id],
    onDelete: Restrict
  )

  @@index([goodsReceiptId])
  @@index([inventoryItemId])
}

/*
|--------------------------------------------------------------------------
| STOCK TRANSFER
|--------------------------------------------------------------------------
*/

model StockTransfer {
  id             String         @id @default(cuid())
  organizationId String

  transferNo     String

  fromBranchId   String
  toBranchId     String

  status         TransferStatus @default(DRAFT)

  requestedById  String
  approvedById   String?
  shippedById    String?
  receivedById   String?

  requestedAt    DateTime?
  approvedAt     DateTime?
  shippedAt      DateTime?
  receivedAt     DateTime?

  notes          String?        @db.Text

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization   Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  fromBranch     Branch @relation(
    "TransferFromBranch",
    fields: [fromBranchId],
    references: [id],
    onDelete: Restrict
  )

  toBranch       Branch @relation(
    "TransferToBranch",
    fields: [toBranchId],
    references: [id],
    onDelete: Restrict
  )

  requestedBy    User @relation(
    "TransferRequestedBy",
    fields: [requestedById],
    references: [id],
    onDelete: Restrict
  )

  approvedBy     User? @relation(
    "TransferApprovedBy",
    fields: [approvedById],
    references: [id],
    onDelete: SetNull
  )

  shippedBy      User? @relation(
    "TransferShippedBy",
    fields: [shippedById],
    references: [id],
    onDelete: SetNull
  )

  receivedBy     User? @relation(
    "TransferReceivedBy",
    fields: [receivedById],
    references: [id],
    onDelete: SetNull
  )

  items          StockTransferItem[]

  @@unique([organizationId, transferNo])
  @@index([fromBranchId, status])
  @@index([toBranchId, status])
}

model StockTransferItem {
  id              String   @id @default(cuid())
  stockTransferId String
  inventoryItemId String

  quantity        Decimal  @db.Decimal(18, 3)
  receivedQuantity Decimal @default(0) @db.Decimal(18, 3)
  unitCost        Decimal  @default(0) @db.Decimal(18, 4)

  stockTransfer   StockTransfer @relation(
    fields: [stockTransferId],
    references: [id],
    onDelete: Cascade
  )

  inventoryItem   InventoryItem @relation(
    fields: [inventoryItemId],
    references: [id],
    onDelete: Restrict
  )

  @@index([stockTransferId])
  @@index([inventoryItemId])
}

/*
|--------------------------------------------------------------------------
| CUSTOMER / CRM
|--------------------------------------------------------------------------
*/

model Customer {
  id             String       @id @default(cuid())
  organizationId String

  customerCode   String
  name           String

  phone          String?
  email          String?

  billingAddress String?      @db.Text
  shippingAddress String?     @db.Text

  tin            String?
  bin            String?

  openingBalance Decimal      @default(0) @db.Decimal(18, 2)
  creditLimit    Decimal?     @db.Decimal(18, 2)
  paymentTerms   String?

  status         RecordStatus @default(ACTIVE)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  addresses      CustomerAddress[]

  orders         Order[]
  invoices       SalesInvoice[]
  ledgerEntries  CustomerLedgerEntry[]

  loyaltyAccount LoyaltyAccount?

  reviews        ProductReview[]

  carts          Cart[]

  likes          ProductLike[]
  comments       ProductComment[]
  shares         ProductShare[]

  @@unique([organizationId, customerCode])
  @@index([organizationId, phone])
  @@index([organizationId, email])
  @@index([organizationId, status])
}

model CustomerAddress {
  id             String   @id @default(cuid())
  customerId     String

  label          String?
  recipientName  String?
  phone          String?

  addressLine1   String
  addressLine2   String?
  area           String?
  city           String?
  postalCode     String?
  country        String   @default("Bangladesh")

  latitude       Decimal? @db.Decimal(10, 7)
  longitude      Decimal? @db.Decimal(10, 7)

  isDefault      Boolean  @default(false)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customer       Customer @relation(
    fields: [customerId],
    references: [id],
    onDelete: Cascade
  )

  orders         Order[]

  @@index([customerId])
}

/*
|--------------------------------------------------------------------------
| DELIVERY
|--------------------------------------------------------------------------
*/

model DeliveryZone {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String?

  name           String
  description    String?

  deliveryFee    Decimal  @default(0) @db.Decimal(18, 2)
  minimumOrder   Decimal  @default(0) @db.Decimal(18, 2)

  estimatedMin   Int?
  estimatedMax   Int?

  isActive       Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  branch         Branch? @relation(
    fields: [branchId],
    references: [id],
    onDelete: Cascade
  )

  deliveries     Delivery[]

  @@index([organizationId, isActive])
  @@index([branchId])
}

model RiderProfile {
  id          String       @id @default(cuid())
  userId      String       @unique

  riderCode   String
  vehicleType String?
  vehicleNo   String?

  status      RiderStatus  @default(OFFLINE)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user        User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  deliveries  Delivery[]
  assignments DeliveryAssignment[]
}

model Delivery {
  id              String         @id @default(cuid())
  orderId         String         @unique

  zoneId          String?
  riderId         String?

  status          DeliveryStatus @default(PENDING)

  recipientName   String?
  recipientPhone  String?

  addressSnapshot String         @db.Text

  latitude        Decimal?       @db.Decimal(10, 7)
  longitude       Decimal?       @db.Decimal(10, 7)

  deliveryFee     Decimal        @default(0) @db.Decimal(18, 2)

  assignedAt      DateTime?
  pickedUpAt      DateTime?
  outForDeliveryAt DateTime?
  deliveredAt     DateTime?

  failureReason   String?        @db.Text

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  order           Order @relation(
    fields: [orderId],
    references: [id],
    onDelete: Cascade
  )

  zone            DeliveryZone? @relation(
    fields: [zoneId],
    references: [id],
    onDelete: SetNull
  )

  rider           RiderProfile? @relation(
    fields: [riderId],
    references: [id],
    onDelete: SetNull
  )

  assignments     DeliveryAssignment[]

  @@index([status])
  @@index([riderId, status])
}

model DeliveryAssignment {
  id          String   @id @default(cuid())
  deliveryId  String
  riderId     String

  assignedAt  DateTime @default(now())
  unassignedAt DateTime?

  note        String?

  delivery    Delivery @relation(
    fields: [deliveryId],
    references: [id],
    onDelete: Cascade
  )

  rider       RiderProfile @relation(
    fields: [riderId],
    references: [id],
    onDelete: Restrict
  )

  @@index([deliveryId])
  @@index([riderId])
}

/*
|--------------------------------------------------------------------------
| DINING TABLE / RESERVATION
|--------------------------------------------------------------------------
*/

model DiningTable {
  id             String      @id @default(cuid())
  organizationId String
  branchId       String

  tableNumber    String
  name           String?
  capacity       Int

  status         TableStatus @default(AVAILABLE)

  qrCode         String?
  qrToken        String?     @unique

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization   Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  branch         Branch @relation(
    fields: [branchId],
    references: [id],
    onDelete: Cascade
  )

  orders         Order[]
  reservations   Reservation[]

  @@unique([branchId, tableNumber])
  @@index([branchId, status])
}

model Reservation {
  id             String            @id @default(cuid())
  organizationId String
  branchId       String
  customerId     String?
  tableId        String?

  reservationNo  String

  guestName      String
  guestPhone     String?
  guestEmail     String?

  guestCount     Int

  reservationAt  DateTime
  status         ReservationStatus @default(PENDING)

  notes          String?           @db.Text

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization   Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  branch         Branch @relation(
    fields: [branchId],
    references: [id],
    onDelete: Restrict
  )

  customer       Customer? @relation(
    fields: [customerId],
    references: [id],
    onDelete: SetNull
  )

  table          DiningTable? @relation(
    fields: [tableId],
    references: [id],
    onDelete: SetNull
  )

  @@unique([organizationId, reservationNo])
  @@index([branchId, reservationAt])
  @@index([customerId])
}

/*
|--------------------------------------------------------------------------
| CART
|--------------------------------------------------------------------------
*/

model Cart {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String?
  branchId       String?

  sessionToken   String   @unique

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  expiresAt      DateTime?

  organization   Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  customer       Customer? @relation(
    fields: [customerId],
    references: [id],
    onDelete: SetNull
  )

  branch         Branch? @relation(
    fields: [branchId],
    references: [id],
    onDelete: SetNull
  )

  items          CartItem[]

  @@index([organizationId, customerId])
}

model CartItem {
  id          String   @id @default(cuid())
  cartId      String
  productId   String
  variantId   String?

  quantity    Decimal  @db.Decimal(18, 3)

  unitPrice   Decimal  @db.Decimal(18, 2)

  modifierSnapshot Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cart        Cart @relation(
    fields: [cartId],
    references: [id],
    onDelete: Cascade
  )

  product     Product @relation(
    fields: [productId],
    references: [id],
    onDelete: Restrict
  )

  variant     ProductVariant? @relation(
    fields: [variantId],
    references: [id],
    onDelete: SetNull
  )

  @@index([cartId])
  @@index([productId])
}

/*
|--------------------------------------------------------------------------
| ORDERS
|--------------------------------------------------------------------------
*/

model Order {
  id              String             @id @default(cuid())
  organizationId  String
  branchId        String

  customerId      String?
  customerAddressId String?

  tableId         String?

  orderNo         String

  orderType       OrderType
  channel         OrderChannel

  status          OrderStatus        @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)
  paymentStatus   PaymentStatus      @default(UNPAID)

  subtotal        Decimal            @default(0) @db.Decimal(18, 2)
  discount        Decimal            @default(0) @db.Decimal(18, 2)
  tax             Decimal            @default(0) @db.Decimal(18, 2)
  serviceCharge   Decimal            @default(0) @db.Decimal(18, 2)
  deliveryFee     Decimal            @default(0) @db.Decimal(18, 2)

  total           Decimal            @default(0) @db.Decimal(18, 2)
  paidAmount      Decimal            @default(0) @db.Decimal(18, 2)
  dueAmount       Decimal            @default(0) @db.Decimal(18, 2)

  currency        String             @default("BDT")

  customerNameSnapshot  String?
  customerPhoneSnapshot String?

  billingAddressSnapshot  String?    @db.Text
  shippingAddressSnapshot String?    @db.Text

  notes           String?            @db.Text

  createdById     String?

  confirmedAt     DateTime?
  preparingAt     DateTime?
  readyAt         DateTime?
  deliveredAt     DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  organization    Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  branch          Branch @relation(
    fields: [branchId],
    references: [id],
    onDelete: Restrict
  )

  customer        Customer? @relation(
    fields: [customerId],
    references: [id],
    onDelete: SetNull
  )

  customerAddress CustomerAddress? @relation(
    fields: [customerAddressId],
    references: [id],
    onDelete: SetNull
  )

  table           DiningTable? @relation(
    fields: [tableId],
    references: [id],
    onDelete: SetNull
  )

  createdBy       User? @relation(
    "OrderCreatedBy",
    fields: [createdById],
    references: [id],
    onDelete: SetNull
  )

  items           OrderItem[]
  payments        OrderPayment[]
  refunds         Refund[]

  statusHistory   OrderStatusHistory[]

  delivery        Delivery?

  kitchenTickets  KitchenTicket[]

  invoice         SalesInvoice?

  review          ProductReview[]

  @@unique([organizationId, orderNo])
  @@index([branchId, status, createdAt])
  @@index([customerId, createdAt])
  @@index([paymentStatus])
  @@index([fulfillmentStatus])
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  productId       String
  variantId       String?

  productName     String
  variantName     String?

  sku             String?
  barcode         String?

  quantity        Decimal  @db.Decimal(18, 3)

  unitPrice       Decimal  @db.Decimal(18, 2)
  discount        Decimal  @default(0) @db.Decimal(18, 2)
  tax             Decimal  @default(0) @db.Decimal(18, 2)
  total           Decimal  @db.Decimal(18, 2)

  taxRate         Decimal? @db.Decimal(8, 4)

  note            String?  @db.Text

  createdAt       DateTime @default(now())

  order           Order @relation(
    fields: [orderId],
    references: [id],
    onDelete: Cascade
  )

  product         Product @relation(
    fields: [productId],
    references: [id],
    onDelete: Restrict
  )

  variant         ProductVariant? @relation(
    fields: [variantId],
    references: [id],
    onDelete: SetNull
  )

  modifiers       OrderItemModifier[]

  kitchenItems    KitchenTicketItem[]

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model OrderItemModifier {
  id          String   @id @default(cuid())
  orderItemId String
  modifierId  String

  modifierName String
  quantity     Decimal @default(1) @db.Decimal(18, 3)
  unitPrice    Decimal @default(0) @db.Decimal(18, 2)
  total        Decimal @default(0) @db.Decimal(18, 2)

  orderItem    OrderItem @relation(
    fields: [orderItemId],
    references: [id],
    onDelete: Cascade
  )

  modifier     Modifier @relation(
    fields: [modifierId],
    references: [id],
    onDelete: Restrict
  )

  @@index([orderItemId])
  @@index([modifierId])
}

model OrderStatusHistory {
  id          String      @id @default(cuid())
  orderId     String

  fromStatus  OrderStatus?
  toStatus    OrderStatus

  note        String?     @db.Text

  changedById String?
  createdAt   DateTime    @default(now())

  order       Order @relation(
    fields: [orderId],
    references: [id],
    onDelete: Cascade
  )

  changedBy   User? @relation(
    "OrderStatusChangedBy",
    fields: [changedById],
    references: [id],
    onDelete: SetNull
  )

  @@index([orderId, createdAt])
}

model OrderPayment {
  id              String                  @id @default(cuid())
  orderId         String

  paymentMethod   PaymentMethod
  amount          Decimal                 @db.Decimal(18, 2)

  transactionId   String?
  provider        String?

  status          PaymentTransactionStatus @default(PENDING)

  paidAt          DateTime?

  metadata        Json?

  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  order           Order @relation(
    fields: [orderId],
    references: [id],
    onDelete: Cascade
  )

  @@index([orderId])
  @@index([transactionId])
  @@index([status])
}

model Refund {
  id             String   @id @default(cuid())
  orderId        String

  refundNo       String
  amount         Decimal  @db.Decimal(18, 2)

  reason         String?  @db.Text

  status         PaymentTransactionStatus @default(PENDING)

  processedAt    DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  order          Order @relation(
    fields: [orderId],
    references: [id],
    onDelete: Cascade
  )

  items          RefundItem[]

  @@unique([refundNo])
  @@index([orderId])
}

model RefundItem {
  id          String   @id @default(cuid())
  refundId    String
  orderItemId String

  quantity    Decimal  @db.Decimal(18, 3)
  amount      Decimal  @db.Decimal(18, 2)

  refund      Refund @relation(
    fields: [refundId],
    references: [id],
    onDelete: Cascade
  )

  @@index([refundId])
  @@index([orderItemId])
}

/*
|--------------------------------------------------------------------------
| KITCHEN
|--------------------------------------------------------------------------
*/

model KitchenStation {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String

  name           String
  code           String

  isActive       Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  branch         Branch @relation(
    fields: [branchId],
    references: [id],
    onDelete: Cascade
  )

  tickets        KitchenTicket[]

  @@unique([branchId, code])
}

model KitchenTicket {
  id             String             @id @default(cuid())
  orderId        String
  stationId      String

  ticketNo       String

  status         KitchenTicketStatus @default(QUEUED)

  startedAt      DateTime?
  readyAt        DateTime?
  completedAt    DateTime?

  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  order          Order @relation(
    fields: [orderId],
    references: [id],
    onDelete: Cascade
  )

  station        KitchenStation @relation(
    fields: [stationId],
    references: [id],
    onDelete: Restrict
  )

  items          KitchenTicketItem[]

  @@unique([orderId, stationId])
  @@index([stationId, status])
}

model KitchenTicketItem {
  id             String            @id @default(cuid())
  kitchenTicketId String
  orderItemId    String

  quantity       Decimal           @db.Decimal(18, 3)
  status         KitchenItemStatus @default(PENDING)

  startedAt      DateTime?
  readyAt        DateTime?

  kitchenTicket  KitchenTicket @relation(
    fields: [kitchenTicketId],
    references: [id],
    onDelete: Cascade
  )

  orderItem      OrderItem @relation(
    fields: [orderItemId],
    references: [id],
    onDelete: Cascade
  )

  @@index([kitchenTicketId, status])
}

/*
|--------------------------------------------------------------------------
| POS
|--------------------------------------------------------------------------
*/

model POSDevice {
  id             String          @id @default(cuid())
  organizationId String
  branchId       String

  name           String
  deviceCode     String

  status         POSDeviceStatus @default(ACTIVE)

  lastSeenAt     DateTime?

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization   Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  branch         Branch @relation(
    fields: [branchId],
    references: [id],
    onDelete: Cascade
  )

  shifts         POSShift[]

  @@unique([organizationId, deviceCode])
  @@index([branchId, status])
}

model POSShift {
  id             String         @id @default(cuid())
  organizationId String
  branchId       String
  deviceId       String?

  status         POSShiftStatus @default(OPEN)

  openedById     String
  closedById     String?

  openingCash    Decimal        @default(0) @db.Decimal(18, 2)
  expectedCash   Decimal        @default(0) @db.Decimal(18, 2)
  closingCash    Decimal?       @db.Decimal(18, 2)

  cashDifference Decimal?       @db.Decimal(18, 2)

  openedAt       DateTime       @default(now())
  closedAt       DateTime?

  notes          String?        @db.Text

  organization   Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  branch         Branch @relation(
    fields: [branchId],
    references: [id],
    onDelete: Restrict
  )

  device         POSDevice? @relation(
    fields: [deviceId],
    references: [id],
    onDelete: SetNull
  )

  openedBy       User @relation(
    "ShiftOpenedBy",
    fields: [openedById],
    references: [id],
    onDelete: Restrict
  )

  closedBy       User? @relation(
    "ShiftClosedBy",
    fields: [closedById],
    references: [id],
    onDelete: SetNull
  )

  cashTransactions CashTransaction[]

  @@index([branchId, status])
}

model CashTransaction {
  id          String              @id @default(cuid())
  shiftId     String

  type        CashTransactionType
  amount      Decimal             @db.Decimal(18, 2)

  reason      String?             @db.Text
  referenceType String?
  referenceId String?

  createdAt   DateTime            @default(now())

  shift       POSShift @relation(
    fields: [shiftId],
    references: [id],
    onDelete: Cascade
  )

  @@index([shiftId, createdAt])
}

/*
|--------------------------------------------------------------------------
| TAX / DISCOUNT / PROMOTION
|--------------------------------------------------------------------------
*/

model TaxRate {
  id             String   @id @default(cuid())
  organizationId String

  name           String
  code           String?
  type           TaxType

  rate           Decimal  @db.Decimal(8, 4)

  isInclusive    Boolean  @default(false)
  isActive       Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  products       Product[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

model Discount {
  id             String       @id @default(cuid())
  organizationId String

  name           String
  type           DiscountType
  value          Decimal      @db.Decimal(18, 4)

  maxDiscount    Decimal?     @db.Decimal(18, 2)
  minOrderAmount Decimal?     @db.Decimal(18, 2)

  isActive       Boolean      @default(true)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  @@index([organizationId, isActive])
}

model Promotion {
  id             String          @id @default(cuid())
  organizationId String

  name           String
  description    String?         @db.Text

  status         PromotionStatus @default(DRAFT)

  startsAt       DateTime?
  endsAt         DateTime?

  rules          Json?
  reward         Json?

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization   Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  @@index([organizationId, status])
}

model Coupon {
  id             String       @id @default(cuid())
  organizationId String

  code           String
  description    String?      @db.Text

  discountType   DiscountType
  discountValue  Decimal      @db.Decimal(18, 4)

  minimumOrder   Decimal?     @db.Decimal(18, 2)
  maximumDiscount Decimal?    @db.Decimal(18, 2)

  usageLimit     Int?
  usageCount     Int          @default(0)

  perCustomerLimit Int?

  startsAt       DateTime?
  expiresAt      DateTime?

  status         CouponStatus @default(ACTIVE)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  redemptions    CouponRedemption[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

model CouponRedemption {
  id          String   @id @default(cuid())
  couponId    String
  customerId  String?
  orderId     String

  discountAmount Decimal @db.Decimal(18, 2)

  createdAt   DateTime @default(now())

  coupon      Coupon @relation(
    fields: [couponId],
    references: [id],
    onDelete: Restrict
  )

  @@unique([couponId, orderId])
  @@index([customerId])
}

/*
|--------------------------------------------------------------------------
| LOYALTY
|--------------------------------------------------------------------------
*/

model LoyaltyProgram {
  id             String   @id @default(cuid())
  organizationId String

  name           String
  pointsPerAmount Decimal @default(1) @db.Decimal(18, 4)
  amountPerPoint  Decimal @default(1) @db.Decimal(18, 4)

  minimumRedeemPoints Int @default(0)

  isActive       Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  accounts       LoyaltyAccount[]

  @@index([organizationId, isActive])
}

model LoyaltyAccount {
  id             String   @id @default(cuid())
  customerId     String   @unique
  programId      String

  pointsBalance  Decimal  @default(0) @db.Decimal(18, 2)
  lifetimeEarned Decimal  @default(0) @db.Decimal(18, 2)
  lifetimeRedeemed Decimal @default(0) @db.Decimal(18, 2)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customer       Customer @relation(
    fields: [customerId],
    references: [id],
    onDelete: Cascade
  )

  program        LoyaltyProgram @relation(
    fields: [programId],
    references: [id],
    onDelete: Restrict
  )

  transactions   LoyaltyTransaction[]

  @@index([programId])
}

model LoyaltyTransaction {
  id          String                @id @default(cuid())
  accountId   String

  type        LoyaltyTransactionType
  points      Decimal               @db.Decimal(18, 2)

  referenceType String?
  referenceId String?

  note        String?

  createdAt   DateTime              @default(now())

  account     LoyaltyAccount @relation(
    fields: [accountId],
    references: [id],
    onDelete: Cascade
  )

  @@index([accountId, createdAt])
}

/*
|--------------------------------------------------------------------------
| PRODUCT REVIEWS
|--------------------------------------------------------------------------
*/

model ProductReview {
  id             String       @id @default(cuid())
  productId      String
  customerId     String
  orderId        String?

  rating         Int
  title          String?
  comment        String?      @db.Text

  status         ReviewStatus @default(PENDING)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  product        Product @relation(
    fields: [productId],
    references: [id],
    onDelete: Cascade
  )

  customer       Customer @relation(
    fields: [customerId],
    references: [id],
    onDelete: Cascade
  )

  order          Order? @relation(
    fields: [orderId],
    references: [id],
    onDelete: SetNull
  )

  @@index([productId, status])
  @@index([customerId])
}

/*
|--------------------------------------------------------------------------
| ACCOUNTING
|--------------------------------------------------------------------------
*/

model ChartOfAccount {
  id             String        @id @default(cuid())
  organizationId String

  parentId       String?

  code           String
  name           String
  description    String?

  type           AccountType
  normalBalance  NormalBalance

  isSystem       Boolean       @default(false)
  isActive       Boolean       @default(true)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  parent         ChartOfAccount? @relation(
    "AccountTree",
    fields: [parentId],
    references: [id],
    onDelete: SetNull
  )

  children       ChartOfAccount[] @relation("AccountTree")

  journalLines   JournalLine[]

  @@unique([organizationId, code])
  @@index([organizationId, type, isActive])
}

model AccountingPeriod {
  id             String                 @id @default(cuid())
  organizationId String

  name           String

  startDate      DateTime
  endDate        DateTime

  status         AccountingPeriodStatus @default(OPEN)

  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization   Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  journalEntries JournalEntry[]

  @@unique([organizationId, name])
  @@index([organizationId, startDate, endDate])
}

model JournalEntry {
  id             String              @id @default(cuid())
  organizationId String
  branchId       String?
  periodId       String

  entryNo        String

  entryDate      DateTime            @default(now())

  sourceType     JournalSourceType
  sourceId       String?

  description    String?             @db.Text

  status         JournalEntryStatus  @default(DRAFT)

  createdById    String

  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization   Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  branch         Branch? @relation(
    fields: [branchId],
    references: [id],
    onDelete: SetNull
  )

  period         AccountingPeriod @relation(
    fields: [periodId],
    references: [id],
    onDelete: Restrict
  )

  createdBy      User @relation(
    "JournalCreatedBy",
    fields: [createdById],
    references: [id],
    onDelete: Restrict
  )

  lines          JournalLine[]

  @@unique([organizationId, entryNo])
  @@index([branchId, entryDate])
  @@index([sourceType, sourceId])
  @@index([periodId, status])
}

model JournalLine {
  id             String   @id @default(cuid())
  journalEntryId String
  accountId      String
  branchId       String?

  customerId     String?
  supplierId     String?

  description    String?

  debit          Decimal  @default(0) @db.Decimal(18, 2)
  credit         Decimal  @default(0) @db.Decimal(18, 2)

  journalEntry   JournalEntry @relation(
    fields: [journalEntryId],
    references: [id],
    onDelete: Cascade
  )

  account        ChartOfAccount @relation(
    fields: [accountId],
    references: [id],
    onDelete: Restrict
  )

  @@index([journalEntryId])
  @@index([accountId])
  @@index([branchId])
  @@index([customerId])
  @@index([supplierId])
}

model SalesInvoice {
  id             String        @id @default(cuid())
  organizationId String
  orderId        String        @unique
  customerId     String?

  invoiceNo      String

  status         InvoiceStatus @default(DRAFT)

  invoiceDate    DateTime      @default(now())
  dueDate        DateTime?

  subtotal       Decimal       @default(0) @db.Decimal(18, 2)
  discount       Decimal       @default(0) @db.Decimal(18, 2)
  tax            Decimal       @default(0) @db.Decimal(18, 2)
  total          Decimal       @default(0) @db.Decimal(18, 2)

  paidAmount     Decimal       @default(0) @db.Decimal(18, 2)
  dueAmount      Decimal       @default(0) @db.Decimal(18, 2)

  notes          String?       @db.Text

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  order          Order @relation(
    fields: [orderId],
    references: [id],
    onDelete: Restrict
  )

  customer       Customer? @relation(
    fields: [customerId],
    references: [id],
    onDelete: SetNull
  )

  items          SalesInvoiceItem[]

  @@unique([organizationId, invoiceNo])
  @@index([customerId, invoiceDate])
  @@index([status])
}

model SalesInvoiceItem {
  id             String   @id @default(cuid())
  invoiceId      String

  productId      String?
  productName    String

  quantity       Decimal  @db.Decimal(18, 3)
  unitPrice      Decimal  @db.Decimal(18, 2)

  discount       Decimal  @default(0) @db.Decimal(18, 2)
  tax            Decimal  @default(0) @db.Decimal(18, 2)
  total          Decimal  @db.Decimal(18, 2)

  invoice        SalesInvoice @relation(
    fields: [invoiceId],
    references: [id],
    onDelete: Cascade
  )

  @@index([invoiceId])
  @@index([productId])
}

model CustomerLedgerEntry {
  id             String          @id @default(cuid())
  organizationId String
  customerId     String

  entryType      LedgerEntryType

  referenceType  String?
  referenceId    String?

  debit          Decimal         @default(0) @db.Decimal(18, 2)
  credit         Decimal         @default(0) @db.Decimal(18, 2)

  balance        Decimal         @default(0) @db.Decimal(18, 2)

  description    String?         @db.Text

  entryDate      DateTime        @default(now())

  organization   Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  customer       Customer @relation(
    fields: [customerId],
    references: [id],
    onDelete: Cascade
  )

  @@index([customerId, entryDate])
  @@index([referenceType, referenceId])
}

model SupplierBill {
  id             String        @id @default(cuid())
  organizationId String
  supplierId     String
  purchaseOrderId String?

  billNo         String
  status         InvoiceStatus @default(DRAFT)

  billDate       DateTime      @default(now())
  dueDate        DateTime?

  subtotal       Decimal       @default(0) @db.Decimal(18, 2)
  tax            Decimal       @default(0) @db.Decimal(18, 2)
  total          Decimal       @default(0) @db.Decimal(18, 2)

  paidAmount     Decimal       @default(0) @db.Decimal(18, 2)
  dueAmount      Decimal       @default(0) @db.Decimal(18, 2)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  supplier       Supplier @relation(
    fields: [supplierId],
    references: [id],
    onDelete: Restrict
  )

  items          SupplierBillItem[]
  ledgerEntries  SupplierLedgerEntry[]

  @@unique([organizationId, billNo])
  @@index([supplierId, billDate])
}

model SupplierBillItem {
  id             String   @id @default(cuid())
  billId         String

  inventoryItemId String?
  itemName       String

  quantity       Decimal  @db.Decimal(18, 3)
  unitPrice      Decimal  @db.Decimal(18, 2)

  tax            Decimal  @default(0) @db.Decimal(18, 2)
  total          Decimal  @db.Decimal(18, 2)

  bill           SupplierBill @relation(
    fields: [billId],
    references: [id],
    onDelete: Cascade
  )

  @@index([billId])
  @@index([inventoryItemId])
}

model SupplierLedgerEntry {
  id             String          @id @default(cuid())
  organizationId String
  supplierId     String
  billId         String?

  entryType      LedgerEntryType

  referenceType  String?
  referenceId    String?

  debit          Decimal         @default(0) @db.Decimal(18, 2)
  credit         Decimal         @default(0) @db.Decimal(18, 2)

  balance        Decimal         @default(0) @db.Decimal(18, 2)

  description    String?         @db.Text

  entryDate      DateTime        @default(now())

  organization   Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  supplier       Supplier @relation(
    fields: [supplierId],
    references: [id],
    onDelete: Cascade
  )

  bill           SupplierBill? @relation(
    fields: [billId],
    references: [id],
    onDelete: SetNull
  )

  @@index([supplierId, entryDate])
  @@index([billId])
}

model ExpenseCategory {
  id             String       @id @default(cuid())
  organizationId String

  name           String
  description    String?

  status         RecordStatus @default(ACTIVE)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  expenses       Expense[]

  @@unique([organizationId, name])
}

model Expense {
  id             String        @id @default(cuid())
  organizationId String
  branchId       String
  categoryId     String

  expenseNo      String

  amount         Decimal       @db.Decimal(18, 2)

  expenseDate    DateTime      @default(now())

  description    String?       @db.Text

  paymentMethod  PaymentMethod

  status         ExpenseStatus @default(DRAFT)

  createdById    String
  approvedById   String?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  branch         Branch @relation(
    fields: [branchId],
    references: [id],
    onDelete: Restrict
  )

  category       ExpenseCategory @relation(
    fields: [categoryId],
    references: [id],
    onDelete: Restrict
  )

  createdBy      User @relation(
    "ExpenseCreatedBy",
    fields: [createdById],
    references: [id],
    onDelete: Restrict
  )

  approvedBy     User? @relation(
    "ExpenseApprovedBy",
    fields: [approvedById],
    references: [id],
    onDelete: SetNull
  )

  @@unique([organizationId, expenseNo])
  @@index([branchId, expenseDate])
  @@index([categoryId])
}

/*
|--------------------------------------------------------------------------
| NOTIFICATIONS
|--------------------------------------------------------------------------
*/

model Notification {
  id             String               @id @default(cuid())
  organizationId String
  userId         String?

  type           NotificationType
  channel        NotificationChannel

  title          String
  message        String               @db.Text

  referenceType  String?
  referenceId    String?

  status         NotificationStatus   @default(PENDING)

  sentAt         DateTime?
  readAt         DateTime?

  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization   Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  user           User? @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  @@index([userId, status, createdAt])
  @@index([organizationId, type])
}

/*
|--------------------------------------------------------------------------
| AUDIT LOG
|--------------------------------------------------------------------------
*/

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String?
  userId         String?

  action         String
  entityType     String
  entityId       String?

  oldData        Json?
  newData        Json?

  ipAddress      String?
  userAgent      String?  @db.Text
  requestId      String?

  createdAt      DateTime @default(now())

  organization   Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  branch         Branch? @relation(
    fields: [branchId],
    references: [id],
    onDelete: SetNull
  )

  user           User? @relation(
    fields: [userId],
    references: [id],
    onDelete: SetNull
  )

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([requestId])
}