# ===========================================
# APPLICATION
# ===========================================
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
APP_NAME=RestaurantPOS API
APP_URL=http://localhost:5000

# ===========================================
# DATABASE (MySQL / MariaDB)
# ===========================================
DATABASE_URL="mysql://root:@localhost:3306/brew_flow_db"

# ===========================================
# JWT / AUTH
# ===========================================
JWT_ACCESS_SECRET=jhash23823bysagdAAS!22jjojiojojebrew_flow
JWT_REFRESH_SECRET=jhash23823bysagdAAS!22jjojiojojebrew_flow
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===========================================
# REDIS (optional - for cache / sessions / rate-limit)
# ===========================================
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# ===========================================
# CORS
# ===========================================
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=info

# ===========================================
# GOOGLE OAUTH (optional)
# ===========================================
